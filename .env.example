# Copy this file to .env (which is gitignored) and fill in your real key.
# Or just export it in your shell rc — SaySo reads from env first.

# Groq API key — used for both Whisper (STT) and Llama (LLM polish).
# Get one for free at https://console.groq.com/keys (no credit card needed).
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 中国大陆用户：如果 SaySo 直连 Groq 被屏，让 reqwest 走本地 Clash 端口
# Clash for Windows 默认 7890，V2RayN 默认 10809
# HTTPS_PROXY=http://127.0.0.1:7890

# 触发模式：hold（默认，按住录音松开停止）/ toggle（点一下开始，再点一下停止）
# SAYSO_TRIGGER_MODE=hold

# 静音阈值（i16 amplitude，范围 0-32767）。低于此值的录音视为静音，跳过 Whisper。
# 默认 500（约 -36 dBFS）。嘈杂环境调高到 800-1500，极安静环境降到 200-300。
# SAYSO_SILENCE_THRESHOLD=500

# 全局快捷键。支持：RightAlt(默认) / RightCtrl / RightShift / Pause / ScrollLock
# SAYSO_HOTKEY=RightAlt

# 可选：覆盖默认 STT 端点 / 模型
# SAYSO_STT_BASE_URL=https://api.groq.com/openai/v1
# SAYSO_STT_MODEL=whisper-large-v3-turbo

# 可选：覆盖 Whisper 风格/术语引导 prompt（默认是技术对话场景）
# 设为空字符串 "" 会显式关闭 prompt
# SAYSO_STT_PROMPT="以下是技术对话口述：..."

# 可选：LLM 润色配置（默认开启，用 Groq Llama-3.3-70B 改写转写文本）
# SAYSO_LLM_ENABLED=true             # false / 0 / off / no 可关闭
# SAYSO_LLM_BASE_URL=https://api.groq.com/openai/v1
# SAYSO_LLM_MODEL=llama-3.3-70b-versatile
# SAYSO_LLM_PROMPT="你是一个口述转写清理助手..."
